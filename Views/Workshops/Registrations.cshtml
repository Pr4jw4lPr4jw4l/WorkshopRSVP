@model IReadOnlyList<Rsvp>

@{
    ViewData["Title"] = "Registrations";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <span class="eyebrow text-primary">Attendee directory</span>
        <h1 class="display-6 fw-bold mb-1">Workshop registrations</h1>
        <p class="text-secondary mb-0">Current registrations are stored in memory for this lab.</p>
    </div>
    <a class="btn btn-primary align-self-start" asp-action="RsvpForm">Add registration</a>
</div>

@if (Model.Count == 0)
{
    <section class="empty-state text-center" aria-labelledby="empty-heading">
        <div class="empty-icon" aria-hidden="true">RSVP</div>
        <h2 id="empty-heading" class="h4">No registrations yet</h2>
        <p class="text-secondary">Be the first person to reserve a workshop seat.</p>
        <a class="btn btn-outline-primary" asp-action="RsvpForm">Register now</a>
    </section>
}
else
{
    <div class="table-responsive registration-table-wrap">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Registered workshop participants</caption>
            <thead>
                <tr>
                    <th scope="col">Full name</th>
                    <th scope="col">Workshop</th>
                    <th scope="col">Needs accommodation</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registration in Model)
                {
                    <tr>
                        <td class="fw-semibold">@registration.FullName</td>
                        <td>@registration.WorkshopTitle</td>
                        <td>
                            @if (registration.NeedsAccommodation)
                            {
                                <span class="status-pill status-pill-yes">Yes</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill-no">No</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a class="link-secondary" asp-action="Index">← Back to Workshops</a>
</div>
